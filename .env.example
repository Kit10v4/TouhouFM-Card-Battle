# Environment Configuration
# Copy this file to .env and update with your values

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# Database (Neon PostgreSQL)
# Get this from: https://console.neon.tech -> your project -> Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# JWT Secret (generate a long random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-to-something-random

# Cookie settings (set for Vercel client + Render server)
# production: COOKIE_SECURE=true and COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Email (optional - if not configured, codes will be logged to console)
# Configure these in email-config.js instead
